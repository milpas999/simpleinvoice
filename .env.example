# =============================================================================
# SimpleInvoice — Environment Configuration
# Copy this file to `.env` in the project root and adjust values as needed:
#   cp .env.example .env
#
# This single root-level .env is the source of truth for docker-compose and
# is loaded by the postgres, backend and frontend containers. No secrets
# should ever be hardcoded in source code — everything below is read at
# runtime from environment variables.
# =============================================================================

# ----- General -----
NODE_ENV=development

# ----- PostgreSQL Database -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simple_invoice
# Host port that Postgres is published on (container always listens on 5432 internally)
POSTGRES_PORT=5432

# ----- Backend (NestJS) -----
# Host port the API is published on (container always listens on 3000 internally)
BACKEND_PORT=3000
# Database connection used by TypeORM. When running via docker-compose, DB_HOST
# is overridden to the "db" service name automatically. Set DB_HOST=localhost
# here if you run the backend outside Docker against a local Postgres instance.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=simple_invoice
# Secret used to sign JWT access tokens — change this to a long random value
JWT_SECRET=change_this_to_a_long_random_secret_in_production
# Token lifetime in seconds (defaults to 3600 if unset)
JWT_EXPIRES_IN=3600

# ----- Frontend (React + Vite) -----
# Host port the frontend dev server is published on (container always listens on 5173 internally)
FRONTEND_PORT=5173
# Base URL the frontend uses to reach the backend API from the browser
VITE_API_BASE_URL=http://localhost:3000
